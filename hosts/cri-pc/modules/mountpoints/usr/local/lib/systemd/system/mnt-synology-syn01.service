[Unit]
Description=Service to manage mnt-synology-syn01.mount
After=network-online.target
Requires=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl start mnt-synology-syn01.mount
ExecStop=/usr/bin/systemctl stop mnt-synology-syn01.mount
RemainAfterExit=yes
TimeoutStartSec=3

[Install]
WantedBy=multi-user.target
