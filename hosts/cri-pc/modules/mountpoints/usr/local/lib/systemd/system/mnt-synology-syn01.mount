[Unit]
Description=Local mount unit for synology-syn01
After=network.target local-fs.target
ConditionPathExists=/mnt/synology/syn01
ConditionPathIsMountPoint=!/mnt/synology/syn01

[Mount]
What=synology.home:/volume1/syn01
Where=/mnt/synology/syn01
Type=nfs
Options=rw,nosuid,soft,nfsvers=4,noacl,async,nocto,nconnect=16,_netdev,timeo=3,retrans=2,bg

[Install]
WantedBy=multi-user.target
