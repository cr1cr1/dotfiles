// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^org\\.kde\\."
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="org\\.quickshell$"
    match app-id="^org.freedesktop.impl.portal.desktop.kde$"
    match app-id="^com.usebottles.bottles$" title="Select Bottle"
    match app-id="^org.kde.ark$" title="File Already Exists — Ark"
    match app-id="^blueman-manager$"
    match app-id="^nm-connection-editor$"
    match app-id="^eu.betterbird.Betterbird$"
    match app-id="^syncthingtray-qt6$"
    match app-id="^org.keepassxc.KeePassXC$"
    match app-id="^org.kde.kdeconnect."
    match app-id="^vlc$"
    match app-id="^org.strawberrymusicplayer.strawberry$" title="^Strawberry Error"
    match app-id="^calibre-ebook-viewer$"
    match app-id="^steam$"
    match title="Sign in to Security Device"
    match app-id="^transgui$"
    match app-id="^org.kde.dolphin$" title="^Copying"
    match app-id="^com.gabm.satty$"
    match app-id="^net.davidotek.pupgui2$"
    match app-id="^ocenaudio"
    match app-id="^org-kse-KSE$"
    match app-id="com.danklinux.dms"
    exclude app-id="^eu.betterbird.Betterbird$" title="^Betterbird$"
    exclude app-id="^vlc$" title="VLC media player$"
    exclude app-id="^steam$" title="^Steam$"
    exclude app-id="^transgui$" title="^Transmission Remote GUI"
    open-floating true
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="btop-floating"
    match app-id="io.missioncenter.MissionCenter"
    match app-id="syncthingtray-qt6" title="\\| Syncthing$"
    match app-id="floating-kitty"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.7; }
    default-floating-position x=50 y=50 relative-to="top"
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="dev.zed.Zed"
    open-floating true
    draw-border-with-background false
}

// @id=dms_rule_5 @name=
window-rule {
    match app-id="signal"
    match app-id="teams-for-linux"
    open-on-workspace "2"
    default-column-width { proportion 0.333; }
}

// @id=dms_rule_6 @name=
window-rule {
    match app-id="Thorium-browser" title="WhatsApp Web"
    match app-id="chrome-hnpfjngllnobngcgfapefoaidbinmjnm-Default"
    open-on-workspace "3"
    default-column-width { proportion 0.333; }
}

// @id=dms_rule_7 @name=
window-rule {
    match is-active=false
    opacity 0.90
}

// @id=dms_rule_8 @name=
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// @id=dms_rule_9 @name=
window-rule {
    match is-floating=true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
