[Unit]
Description=NFS mount unit for synology-syn02
Wants=network-online.target
After=network-online.target remote-fs-pre.target
ConditionPathExists=/mnt/synology/syn02

[Mount]
What=synology.home:/volume2/syn02
Where=/mnt/synology/syn02
Type=nfs
Options=rw,soft,nfsvers=4.1,nconnect=4,rsize=1048576,wsize=1048576,noatime,nosuid,nodev,noacl,timeo=60,retrans=2
TimeoutSec=15
