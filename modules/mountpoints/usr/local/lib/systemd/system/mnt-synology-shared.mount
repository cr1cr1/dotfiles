[Unit]
Description=NFS mount unit for synology-shared
Wants=network-online.target
After=network-online.target remote-fs-pre.target
ConditionPathExists=/mnt/synology/shared

[Mount]
What=synology.home:/volume2/shared
Where=/mnt/synology/shared
Type=nfs
Options=rw,hard,nfsvers=4.1,nconnect=4,rsize=1048576,wsize=1048576,noatime,nosuid,nodev,noacl,timeo=600,retrans=2
TimeoutSec=15
